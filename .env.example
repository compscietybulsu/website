# Frontend environment variables (Next.js, repo root).
# Copy to .env.local for local Next overrides: cp .env.example .env.local
# Names only — never commit real values.

# Omit this for the Cloudflare stack: the API lives on the same origin
# (/api on the Worker), so no override is needed.
# Only set it to point at the legacy Express server (server/) for local
# reference work, e.g. NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=
