# Frontend environment variables (Next.js, repo root).
# Copy to .env.local for local/Codespaces: cp .env.example .env.local
# Names only — never commit real values. Secrets stay out of the image.

# Base URL of the backend API (server/), no trailing slash.
# Local dev or desktop Codespaces (localhost forwarding): http://localhost:5000
# Browser Codespaces: use the forwarded URL for port 5000 from the Ports tab
#   (e.g. https://<codespace-name>-5000.app.github.dev)
NEXT_PUBLIC_API_URL=http://localhost:5000
