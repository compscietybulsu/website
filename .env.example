# Frontend / Workers environment (repo root).
# Local Next:  cp .env.example .env.local
# Workers preview: also see .dev.vars.example
# Names only — never commit real values.

# Optional. Leave empty for same-origin /api on this Worker (recommended).
# Only set if you still point at a legacy Express host during migration.
# NEXT_PUBLIC_API_URL=

# JWT for admin auth (also set via `pnpm exec wrangler secret put JWT_SECRET`
# for production, and in .dev.vars for local Workers preview).
# JWT_SECRET=
