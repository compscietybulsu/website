# Frontend environment variables (Next.js, repo root).
# Copy to .env.local for local Next.js:  cp .env.example .env.local
# Names only — never commit real values.
#
# Backend secrets (Mongo, JWT, Cloudinary, CORS) do NOT belong here.
# Put those in server/.env — see server/.env.example.

# Base URL of the Express API (server/), no trailing slash.
# Local: http://localhost:5000
# Codespaces: use the forwarded URL for port 5000 (not localhost from the browser).
# Production (Workers): set as a Workers Build variable before `pnpm run deploy`
# so it is inlined at build time — do not use `wrangler secret put` for this.
NEXT_PUBLIC_API_URL=http://localhost:5000
