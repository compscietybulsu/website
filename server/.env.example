# Backend environment variables (Express API under server/).
# Copy for local/API host:  cp .env.example .env
# Names only — never commit real values.
#
# Load path: server.js and scripts always read server/.env (this directory),
# not the repo-root .env. Keep frontend vars in ../.env.local instead.

# Port the Express server listens on.
PORT=5000

# Origin allowed by CORS. Set to the real frontend origin in production
# (e.g. https://compsciety-web.<account>.workers.dev or your custom domain).
# Leave unset only for local dev (defaults to "*", which is not safe for prod).
CLIENT_URL=

# MongoDB connection string (e.g. MongoDB Atlas).
MONGODB_URI=

# Secret used to sign/verify admin JWTs. Use a long random value in
# production — never reuse across environments.
JWT_SECRET=

# Cloudinary credentials, used to sign direct-upload requests for blog images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
