# Backend environment variables (server/).
# Copy to .env for local dev: cp .env.example .env
# Names only — never commit real values.

# Port the Express server listens on.
PORT=5000

# Origin allowed by CORS. Set to the real frontend origin in production;
# leave unset only for local dev (defaults to "*", which is not safe for prod).
CLIENT_URL=

# MongoDB connection string (e.g. MongoDB Atlas).
MONGODB_URI=

# Secret used to sign/verify admin JWTs. Use a long random value in
# production — never reuse across environments.
JWT_SECRET=

# Cloudinary credentials, used to sign direct-upload requests for blog images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
