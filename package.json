{
  "name": "compsciety-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-upload": "wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply website-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply website-db --local",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:admin:local": "node scripts/seed-admin.mjs --local"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "mongoose": "^9.9.2",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "wrangler": "^4.113.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "unrs-resolver"
    ]
  }
}
