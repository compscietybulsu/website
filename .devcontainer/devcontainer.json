{
  "name": "CompSciety website",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest"
    },
    "ghcr.io/compscietybulsu/devcontainer/node:1": {
      "nodeMajor": "22",
      "pnpmVersion": "10"
    },
    "ghcr.io/compscietybulsu/devcontainer/act:1": {
      "version": "latest",
      "defaultImage": "catthehacker/ubuntu:act-22.04"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/docker-in-docker",
    "ghcr.io/compscietybulsu/devcontainer/node",
    "ghcr.io/compscietybulsu/devcontainer/act"
  ],
  "remoteUser": "vscode",
  "forwardPorts": [3000, 5000],
  "portsAttributes": {
    "3000": { "label": "Next.js (pnpm dev)", "onAutoForward": "notify" },
    "5000": { "label": "Express API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
